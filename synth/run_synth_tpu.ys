# ==============================================================================
# Yosys ASIC Synthesis Script for Apex-TPU
# Target PDK: Nangate 45nm Open Cell Library (Standard VT)
# Top Module: apex_tpu_top
# ==============================================================================

# 1. Read Verilog RTL design files
read_verilog -sv rtl/pe.v
read_verilog -sv rtl/systolic_array.v
read_verilog -sv rtl/skew_unit.v
read_verilog -sv rtl/deskew_unit.v
read_verilog -sv rtl/vector_unit.v
read_verilog -sv rtl/unified_buffer.v
read_verilog -sv rtl/weight_buffer.v
read_verilog -sv rtl/dma_axi_master.v
read_verilog -sv rtl/tpu_controller.v
read_verilog -sv rtl/apex_tpu_top.v

# 2. Elaborate hierarchy
hierarchy -check -top apex_tpu_top

# 3. High-level synthesis & optimizations
proc
opt
fsm
opt
memory
opt

# 4. Tech mapping & arithmetic optimizations
techmap
opt

# 5. Technology mapping to Nangate 45nm standard cell library
dfflibmap -liberty synth/nangate45.lib
abc -liberty synth/nangate45.lib

# 6. Clean-up & optimization
clean

# 7. Print comprehensive cell statistics & silicon area
stat -liberty synth/nangate45.lib

# 8. Write gate-level synthesized netlist
write_verilog -noattr synth/apex_tpu_nangate45_netlist.v
